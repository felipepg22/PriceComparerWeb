# Copy this file to .env and replace the placeholders. Never commit .env.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your-email@gmail.com
# Gmail requires a 16-character App Password, not your normal account password.
Smtp__Password=your-16-character-app-password
Smtp__FromAddress=your-email@gmail.com
Smtp__FromName=PriceComparer
Smtp__EnableSsl=true
