{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ProductSearch": {
    "Provider": "SearXng",
    "SearXngBaseUrl": "http://localhost:8080",
    "MaxCandidates": 20,
    "MaxConcurrency": 5
  },
  "CurrencyConversion": {
    "ProviderEndpoint": "https://open.er-api.com/v6/latest/USD",
    "TimeoutSeconds": 3,
    "CacheDurationMinutes": 15,
    "MaxFreshnessMinutes": 60,
    "SupportedCurrencies": ["BRL", "USD", "EUR"]
  }
}
